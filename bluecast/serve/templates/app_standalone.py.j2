logger = logging.getLogger(__name__)

MODEL_PATH = os.environ.get("MODEL_PATH", "model.pkl")

# Load pipeline
with open(MODEL_PATH, "rb") as f:
    pipeline = dill.load(f)
logger.info(f"Model loaded from {MODEL_PATH}")


